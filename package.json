{
  "name": "@e2b/opencode",
  "version": "0.2.1",
  "description": "E2B sandboxes for OpenCode: workspaces for OpenCode 1, sandboxed shell commands and boxes for OpenCode 2",
  "keywords": [
    "e2b",
    "opencode",
    "opencode-plugin",
    "sandbox"
  ],
  "homepage": "https://github.com/e2b-dev/opencode-e2b#readme",
  "bugs": {
    "url": "https://github.com/e2b-dev/opencode-e2b/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e2b-dev/opencode-e2b.git"
  },
  "bin": {
    "opencode-e2b": "dist/v2/cli/main.js"
  },
  "files": [
    "dist",
    "bin",
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && bun test test/*.test.ts",
    "prepack": "bun run build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware src test index.js",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.23",
    "e2b": "2.56.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@opencode/plugin": "2.1.0",
    "@oxlint/plugins": "1.87.0",
    "@types/bun": "^1.3.13",
    "@types/node": "24.5.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "5.9.2"
  },
  "engines": {
    "bun": ">=1.3.0",
    "opencode": ">=1.16.0"
  }
}
